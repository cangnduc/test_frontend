

/// Logical container for a question. References the active version.
model Question {
  id               String            @id @default(uuid())
  subjectId        String            @map("subject_id")
  createdById      Int?              @map("created_by_id")
  /// Points to the version currently live in the system
  currentVersionId String?           @unique @map("current_version_id")
  /// Timestamp for soft deletion
  deletedAt     DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("UserCreatedQuestions", fields: [createdById], references: [id])
  currentVersion   QuestionVersion?  @relation("CurrentQuestionVersion", fields: [currentVersionId], references: [id])
  versions        QuestionVersion[] @relation("QuestionToVersions")
  tests           TestVersionQuestion[]

  @@index([subjectId])
  @@index([createdById])
  @@map("question")
}

/// Immutable snapshot of a question's content and logic
model QuestionVersion {
  id            String          @id @default(uuid())
  questionId    String          @map("question_id")
  version       Int
  type          QuestionType
  /// Difficulty level (1-10)
  difficulty    Int             @default(1) @db.SmallInt
  /// The main text/prompt of the question
  text          String          @db.Text
  /// Structured data for options, answers, and logic
  data          Json?
  explanation   String?         @db.Text
  /// Default points awarded for this question if not overridden by a test
  defaultPoint  Int             @default(1) @map("default_point")
  visibility    Visibility      @default(PUBLIC)
  /// Link to a specific passage version if this is a passage-based question
  passageVersionId String?       @map("passage_version_id")
  createdById   Int?             @map("created_by_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  question      Question        @relation("QuestionToVersions", fields: [questionId], references: [id], onDelete: Cascade)
  passageVersion   PassageVersion? @relation(fields: [passageVersionId], references: [id])
  createdBy     User?            @relation("UserCreatedQuestionVersions", fields: [createdById], references: [id])
  media         Media[]
  tags                 QuestionTag[]
  testVersionQuestions TestVersionQuestion[]
  attemptQuestions     AttemptQuestion[]
  attemptAnswers       AttemptAnswer[]
  currentVersionOf    Question?      @relation("CurrentQuestionVersion")

  @@unique([questionId, version])
  @@index([type])
  @@index([difficulty])
  @@index([visibility])
  @@index([passageVersionId])
  @@index([createdAt])
  @@map("question_version")
}

