model TestAttempt {
  id String @id @default(uuid())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  testId String @map("test_id")
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  testVersionId   String      @map("test_version_id") // ✅ immutable version taken
  testVersion     TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  status        AttemptStatus @default(IN_PROGRESS)
  attemptNumber Int           @map("attempt_number")

  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")

  globalEndAt DateTime? @map("global_end_at")

  currentSectionId String?         @map("current_section_id")
  currentSection   AttemptSection? @relation("CurrentSection", fields: [currentSectionId], references: [id], onDelete: SetNull)

  totalScore Float?   @default(0) @map("total_score")
  maxScore   Float?   @map("max_score")
  percentage Float?
  passed     Boolean?

  configSnapshot    Json? @map("config_snapshot") // redundant but kept if requested, made optional
  sessionToken      String? @map("session_token")
  clientFingerprint String? @map("client_fingerprint")
  ipAddress         String? @map("ip_address")

  sections  AttemptSection[]  @relation("AttemptSections")
  questions AttemptQuestion[]
  answers   AttemptAnswer[]
  progress  UserTestProgress[]

  @@unique([userId, testId, attemptNumber])
  @@index([userId, testId, status])
  @@index([testVersionId])
  @@map("test_attempt")
}

model AttemptSection {
  id                    String           @id @default(uuid())
  attemptId             String           @map("attempt_id")
  attempt               TestAttempt      @relation("AttemptSections", fields: [attemptId], references: [id], onDelete: Cascade)
  
  testVersionSectionId  String           @map("test_version_section_id") // ✅ versioned section
  testVersionSection    TestVersionSection @relation(fields: [testVersionSectionId], references: [id], onDelete: Cascade)
  
  order               Int
  title               String
  timeLimit           Int?              @map("time_limit")
  selectionMode       SelectionMode?    @map("selection_mode") // ALL_REQUIRED, CHOOSE_N, RANDOM_N
  requiredAnswerCount Int?              @map("required_answer_count")
  status              SectionStatus     @default(LOCKED)
  startedAt           DateTime?         @map("started_at")
  sectionEndAt        DateTime?         @map("section_end_at")
  completedAt         DateTime?         @map("completed_at")
  
  currentAttempts TestAttempt[]     @relation("CurrentSection")
  questions       AttemptQuestion[]
    
  @@unique([attemptId, testVersionSectionId])
  @@index([attemptId, order])
  @@map("attempt_section")
}

model AttemptQuestion {
  id                   String          @id @default(uuid())
  attemptId            String          @map("attempt_id")
  attempt              TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptSectionId     String          @map("attempt_section_id")
  attemptSection       AttemptSection  @relation(fields: [attemptSectionId], references: [id], onDelete: Cascade)
  
  questionVersionId    String          @map("question_version_id") // ✅ versioned question answered
  questionVersion      QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  
  testVersionQuestionId String?        @map("test_version_question_id") // ✅ backlink to the test’s question definition
  testVersionQuestion   TestVersionQuestion? @relation(fields: [testVersionQuestionId], references: [id], onDelete: SetNull)
  
  displayOrder         Int             @map("display_order")
  point                Int
  isRequired           Boolean         @map("is_required")
  answers              AttemptAnswer[]

  @@unique([attemptId, questionVersionId])
  @@index([attemptId, attemptSectionId, displayOrder])
  @@map("attempt_question")
}

model AttemptAnswer {
  id                String          @id @default(uuid())
  attemptId         String          @map("attempt_id")
  attempt           TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestionId String          @map("attempt_question_id")
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  
  questionVersionId String          @map("question_version_id") // ✅ points to versioned question
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  
  response          Json
  pointsAwarded     Float           @default(0) @map("points_awarded")
  isCorrect         Boolean?        @map("is_correct")
  savedAt           DateTime        @default(now()) @map("saved_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  manualGrade ManualGrade?

  @@unique([attemptId, attemptQuestionId])
  @@index([attemptId])
  @@index([attemptQuestionId])
  @@map("attempt_answer")
}

model ManualGrade {
  id              String        @id @default(uuid())
  attemptAnswerId String        @unique @map("attempt_answer_id")
  attemptAnswer   AttemptAnswer @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)

  gradedById    Int             @map("graded_by_id")
  gradedBy      User            @relation("GradedBy", fields: [gradedById], references: [id])
  pointsAwarded Float           @map("points_awarded")
  feedback      String?         @db.Text

  gradedAt  DateTime @default(now()) @map("graded_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("manual_grade")
}
