
/// Logical container for a reading/listening passage. References active version.
model Passage {
  id               String    @id @default(uuid())
  subjectId        String    @map("subject_id")
  createdById      Int?      @map("created_by_id")
  currentVersionId String?   @unique @map("current_version_id")
  /// Timestamp for soft deletion
  deletedAt     DateTime?  @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  subject          Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy        User?     @relation("UserCreatedPassages", fields: [createdById], references: [id])
  currentVersion   PassageVersion? @relation("CurrentPassageVersion", fields: [currentVersionId], references: [id])
  versions        PassageVersion[] @relation("PassageToVersions")

  @@map("passage")
}

/// Immutable snapshot of a passage's content
model PassageVersion {
  id           String       @id @default(uuid())
  passageId    String       @map("passage_id")
  version      Int
  type         PassageType
  title        String
  /// Full content/transcript of the passage
  content      String       @db.Text
  difficulty   Int          @default(1) @db.SmallInt
  visibility   Visibility   @default(PUBLIC)
  explanation  String?      @db.Text
  createdById  Int?         @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  passage      Passage      @relation("PassageToVersions", fields: [passageId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("UserCreatedPassageVersions", fields: [createdById], references: [id])
  media         Media[]
  tags          PassageTag[]
  questions     QuestionVersion[]
  testSections  TestVersionSection[]
  currentVersionOf Passage?       @relation("CurrentPassageVersion")

  @@unique([passageId, version])
  @@index([createdById])
  @@index([type])
  @@index([difficulty])
  @@index([visibility])
  @@map("passage_version")
}