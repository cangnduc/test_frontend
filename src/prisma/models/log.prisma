/// Internal system logs for debugging and observability
model SystemLog {
  id        String   @id @default(uuid())
  level     String   // "INFO", "WARN", "ERROR"
  message   String
  stack     String?  @db.Text
  /// JSON context for structured logging (e.g., request parameters)
  context   Json?
  /// Trace ID to correlate logs across different services or request flows
  traceId   String?  @map("trace_id")
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([userId]) 
  @@index([traceId])
  @@index([createdAt])
  @@map("system_log")
}

/// Security and compliance audit trail for sensitive actions
model AuditLog {
  id         String   @id @default(uuid())
  actorId    Int?     @map("actor_id")
  /// Action performed (e.g., "test.publish", "user.ban")
  action     String
  resource   String   // table name
  resourceId String   @map("resource_id")
  /// Snapshot of the record before the change
  before     Json?
  /// Snapshot of the record after the change
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}